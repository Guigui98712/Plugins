<Window x:Class="RevitHydraulicCalc.UI.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora Hidráulica - Resultados" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Calculadora de Pressão e Vazão" 
                           Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="TxtSystemInfo" Text="Sistema: -" 
                           Foreground="#BDC3C7" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Resumo -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                    CornerRadius="4" Padding="10" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="Pressão na Origem" Foreground="#7F8C8D" FontSize="11"/>
                    <TextBlock x:Name="TxtSourcePressure" Text="-" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                    CornerRadius="4" Padding="10" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="Pontos de Saída" Foreground="#7F8C8D" FontSize="11"/>
                    <TextBlock x:Name="TxtOutletCount" Text="-" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                    CornerRadius="4" Padding="10" Margin="5,0">
                <StackPanel>
                    <TextBlock Text="Pontos Críticos" Foreground="#7F8C8D" FontSize="11"/>
                    <TextBlock x:Name="TxtCriticalCount" Text="-" FontSize="18" FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                    CornerRadius="4" Padding="10" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="Trechos Analisados" Foreground="#7F8C8D" FontSize="11"/>
                    <TextBlock x:Name="TxtSegmentCount" Text="-" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DataGrid de Resultados por Trecho -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                CornerRadius="4" Margin="0,0,0,10">
            <DataGrid x:Name="DgResults" AutoGenerateColumns="False" 
                      IsReadOnly="True" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" RowBackground="White"
                      AlternatingRowBackground="#F9F9F9"
                      CanUserSortColumns="True" CanUserReorderColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Trecho" Binding="{Binding SegmentName}" Width="150"/>
                    <DataGridTextColumn Header="Nó Inicial" Binding="{Binding StartNodeName}" Width="120"/>
                    <DataGridTextColumn Header="Nó Final" Binding="{Binding EndNodeName}" Width="120"/>
                    <DataGridTextColumn Header="Diâmetro (mm)" Binding="{Binding DiameterMm, StringFormat=F1}" Width="100"/>
                    <DataGridTextColumn Header="Compr. (m)" Binding="{Binding LengthM, StringFormat=F2}" Width="90"/>
                    <DataGridTextColumn Header="Vazão (L/s)" Binding="{Binding FlowRateLps, StringFormat=F3}" Width="90"/>
                    <DataGridTextColumn Header="Veloc. (m/s)" Binding="{Binding VelocityMs, StringFormat=F2}" Width="90"/>
                    <DataGridTextColumn Header="Perda Dist. (kPa)" Binding="{Binding DistributedLossKPa, StringFormat=F2}" Width="110"/>
                    <DataGridTextColumn Header="Perda Loc. (kPa)" Binding="{Binding LocalizedLossKPa, StringFormat=F2}" Width="110"/>
                    <DataGridTextColumn Header="Perda Elev. (kPa)" Binding="{Binding ElevationLossKPa, StringFormat=F2}" Width="110"/>
                    <DataGridTextColumn Header="Perda Total (kPa)" Binding="{Binding TotalLossKPa, StringFormat=F2}" Width="110"/>
                    <DataGridTextColumn Header="Pressão Inic. (kPa)" Binding="{Binding StartPressureKPa, StringFormat=F2}" Width="120"/>
                    <DataGridTextColumn Header="Pressão Final (kPa)" Binding="{Binding EndPressureKPa, StringFormat=F2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- DataGrid de Nós -->
        <TextBlock Grid.Row="3" Text="Pontos de Saída (Nós)" FontWeight="Bold" FontSize="14" 
                   Margin="0,0,0,5" Foreground="#2C3E50"/>

        <Border Grid.Row="4" Background="White" BorderBrush="#DDD" BorderThickness="1" 
                CornerRadius="4" Margin="0,0,0,10">
            <DataGrid x:Name="DgNodes" AutoGenerateColumns="False" 
                      IsReadOnly="True" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" RowBackground="White"
                      AlternatingRowBackground="#F9F9F9">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome do Ponto" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Elevação (m)" Binding="{Binding ElevationM, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="Pressão (kPa)" Binding="{Binding PressureKPa, StringFormat=F2}" Width="110"/>
                    <DataGridTextColumn Header="Pressão (mca)" Binding="{Binding PressureMca, StringFormat=F2}" Width="110"/>
                    <DataGridTextColumn Header="Mín. Requerido (kPa)" Binding="{Binding MinRequiredPressureKPa, StringFormat=F2}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCritical}" Value="False">
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botões -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnExportCsv" Content="📄 Exportar CSV" Width="130" Height="35" 
                    Margin="0,0,10,0" Background="#3498DB" Foreground="White" 
                    BorderThickness="0" Click="BtnExportCsv_Click"/>
            <Button x:Name="BtnHighlightCritical" Content="🔴 Destacar Críticos" Width="150" Height="35" 
                    Margin="0,0,10,0" Background="#E67E22" Foreground="White" 
                    BorderThickness="0" Click="BtnHighlightCritical_Click"/>
            <Button x:Name="BtnClose" Content="Fechar" Width="100" Height="35" 
                    Background="#95A5A6" Foreground="White" BorderThickness="0" 
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
